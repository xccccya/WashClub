{
  "name": "wash-club-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "generate:client": "orval --config orval.config.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "eslint": "^8.57.0",
    "openapi-typescript": "^7.4.2",
    "orval": "^6.25.0",
    "turbo": "^2.0.6",
    "typescript": "^5.4.5"
  },
  "pnpm": {
    "overrides": {
      "rollup": "^4.18.0"
    }
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/multer": "^2.0.0",
    "multer": "^2.0.2"
  }
}
