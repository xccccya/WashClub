# =========================
# Wash Club API env 示例文件
# =========================
#
# 使用方式：
# - 将本文件内容复制到 `apps/api/.env`（该文件通常不提交到仓库）
# - 生产环境请通过部署平台/容器注入环境变量，并确保 JWT_SECRET 为强随机值
#

# 数据库连接（Prisma）
DATABASE_URL="mysql://user:pass@localhost:3306/jukecar"

# JWT 认证（必需）
# - 必须配置为强随机字符串（建议 >= 32 字符）
JWT_SECRET="change_me_to_a_strong_random_secret_at_least_32_chars"
JWT_EXPIRES_IN="7d"

# 密码哈希（可选）
# - bcrypt cost factor，数值越大越安全但越耗时；建议 10~12
BCRYPT_SALT_ROUNDS=10

# 游客兜底会员（可选，但游客相关能力会依赖它）
# - 必须是一个真实存在的 Member.id
GUEST_MEMBER_ID=1

# 腾讯云短信（按需）
TENCENTCLOUD_SECRET_ID=""
TENCENTCLOUD_SECRET_KEY=""
SMS_REGION="ap-nanjing"
SMS_SDK_APP_ID=""
SMS_SIGN_NAME=""
SMS_TEMPLATE_ID=""

# 微信小程序（按需）
WECHAT_MINIAPP_APPID=""
WECHAT_MINIAPP_SECRET=""

# 微信支付（按需）
WXPAY_MCHID=""
WXPAY_APPID=""
WXPAY_API_V3_KEY=""
WXPAY_CERT_PATH="./cert/apiclient_cert.pem"
WXPAY_KEY_PATH="./cert/apiclient_key.pem"
WXPAY_PLATFORM_CERT_PATH="./cert/wechatpay_platform.pem"

# 服务配置
PORT=3000
TZ="Asia/Shanghai"
PUBLIC_API_BASE="http://localhost:3000"


