generator client {
	provider = "prisma-client-js"
}

datasource db {
	provider = "mysql"
	url      = env("DATABASE_URL")
}

model User {
	id        Int      @id @default(autoincrement())
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt
	phone     String   @unique
	name      String?
	password  String
	role      String   @default("staff")
	roleId    Int?
	roleRef   AdminRole? @relation(fields: [roleId], references: [id])
	weixinOpenId String? @unique
	washCardLogsOperated WashCardLog[] @relation("UserOperatesWashCardLogs")
	inventoryLogsOperated InventoryLog[]
}

model Member {
	id        Int       @id @default(autoincrement())
	uid       Int       @unique
	createdAt DateTime  @default(now())
	updatedAt DateTime  @updatedAt
	lastActiveAt DateTime?
	avatarUrl String?
	name      String
	phone     String    @unique
	password  String?
	weixinOpenId String? @unique
	points    Int       @default(0)
	balance   Decimal   @default(0)
	levelId   Int?
	level     MemberLevel? @relation(fields: [levelId], references: [id])
	categoryId Int?
	category   MemberCategory? @relation(fields: [categoryId], references: [id])
	tags       MemberTag[]
	vehicles  Vehicle[]
	addresses MemberAddress[]
	washCardsOwned WashCard[] @relation("MemberOwnsWashCards")
	washCardShares WashCardShare[] @relation("WashCardSharesToMember")
	washCardLogsAffected WashCardLog[] @relation("MemberAffectedWashCardLogs")
	orders    Order[]
}

model MemberLevel {
	id     Int    @id @default(autoincrement())
	name   String
	weight Int    @default(0)
	isDefault Boolean @default(false)
	members Member[]
}

model MemberCategory {
	id      Int     @id @default(autoincrement())
	name    String
	weight  Int     @default(0)
	members Member[]
}

model MemberTag {
	id      Int     @id @default(autoincrement())
	name    String  @unique
	isSystem Boolean @default(false)
	members Member[]
}

model AdminRole {
	id         Int      @id @default(autoincrement())
	name       String
	enabled    Boolean  @default(true)
	isSystem   Boolean  @default(false)
	permissions Json
	users      User[]
}

model Vehicle {
	id          Int       @id @default(autoincrement())
	createdAt   DateTime  @default(now())
	updatedAt   DateTime  @updatedAt
	plateNumber String    @unique
	vin         String?
	brand       String?   @default("-")
	series      String?   @default("-")
	typeMain    String    @default("-")
	typeSub     String?   @default("-")
	color       String?   @default("-")
	isDefault   Boolean   @default(false)
	brandImage  String?
	seriesImage String?
	memberId    Int?
	member      Member?   @relation(fields: [memberId], references: [id], onDelete: Cascade)
	washCardLogs WashCardLog[] @relation("VehicleToWashCardLogs")
	queueItems  ServiceQueueItem[]
	orders      Order[]
}


// 洗车计次卡相关
enum WashCardStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

enum WashCardLogAction {
  ADD
  DEDUCT
  SHARE
}

enum WashCardLogReason {
  BACKEND_ADD
  PURCHASE_ADD
  SERVICE_DEDUCT
  REFUND_DEDUCT
  BACKEND_DEDUCT
  SHARE_ADD
  SHARE_REMOVE
}

model WashCard {
  id              Int              @id @default(autoincrement())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  name            String           @default("洗车计次卡")
  ownerMemberId   Int
  owner           Member           @relation("MemberOwnsWashCards", fields: [ownerMemberId], references: [id])
  totalTimes      Int              @default(0)
  remainingTimes  Int              @default(0)
  status          WashCardStatus   @default(ACTIVE)
  expiryAt        DateTime?
  isDefault       Boolean          @default(false)
  cardNo          String           @unique // 8位数字卡号

  shares          WashCardShare[]
  logs            WashCardLog[]
}

model WashCardShare {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  cardId    Int
  card      WashCard  @relation(fields: [cardId], references: [id])
  memberId  Int
  member    Member    @relation("WashCardSharesToMember", fields: [memberId], references: [id])

  @@unique([cardId, memberId])
}

model WashCardLog {
  id               Int                 @id @default(autoincrement())
  createdAt        DateTime            @default(now())
  cardId           Int
  card             WashCard            @relation(fields: [cardId], references: [id])
  action           WashCardLogAction
  reason           WashCardLogReason
  change           Int                 // +增加/-减少次数
  beforeRemaining  Int
  afterRemaining   Int
  remark           String?

  operatorUserId   Int?
  operatorUser     User?               @relation("UserOperatesWashCardLogs", fields: [operatorUserId], references: [id])

  // 订单/业务占位字段（订单尚未开发）
  serviceOrderId   Int?
  purchaseOrderId  Int?
  refundRecordId   Int?

  vehicleId        Int?
  vehicle          Vehicle?            @relation("VehicleToWashCardLogs", fields: [vehicleId], references: [id])

  memberId         Int?                // 预留：关联受影响会员
  member           Member?             @relation("MemberAffectedWashCardLogs", fields: [memberId], references: [id])
}


model ScrollNotice {
	id         Int       @id @default(autoincrement())
	createdAt  DateTime  @default(now())
	updatedAt  DateTime  @updatedAt
	// 通知类型：home 首页；store 商店页
	type       String
	content    String
	enabled    Boolean   @default(false)
}

model AdBanner {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  title        String?  // 可选标题
  imageUrl     String   // 图片 URL（/uploads/...）
  enabled      Boolean  @default(false)
  jumpEnabled  Boolean  @default(false)
  linkPath     String?  // 跳转路径（小程序页面路径）
  weight       Int      @default(0) // 排序权重，越大越靠前
}

// 服务队列相关
enum ServiceQueueStatus {
	IN_QUEUE
	SERVING
	COMPLETED
}

enum ServiceTaskStatus {
	PENDING
	DOING
	DONE
}

model ServiceQueueItem {
	id              Int                 @id @default(autoincrement())
	createdAt       DateTime            @default(now())
	updatedAt       DateTime            @updatedAt

	vehicleId       Int?
	vehicle         Vehicle?            @relation(fields: [vehicleId], references: [id])

	plateNumber     String
	guest           Boolean             @default(false)

	status          ServiceQueueStatus  @default(IN_QUEUE)
	currentTaskIndex Int                @default(0)
	startedAt       DateTime?
	finishedAt      DateTime?

	orderSort       Int                 @default(0)

	tasks           ServiceTask[]
}

model ServiceTask {
	id              Int               @id @default(autoincrement())
	createdAt       DateTime          @default(now())
	updatedAt       DateTime          @updatedAt

	queueItemId     Int
	queueItem       ServiceQueueItem  @relation(fields: [queueItemId], references: [id])

	name            String
	durationMin     Int               @default(5)
	orderIndex      Int               @default(0)
	status          ServiceTaskStatus @default(PENDING)
	startedAt       DateTime?
	finishedAt      DateTime?

	@@index([queueItemId])
	@@index([status])
}

// 短信验证码记录
model SmsCode {
	id         Int       @id @default(autoincrement())
	createdAt  DateTime  @default(now())
	phone      String
	code       String
	purpose    String    @default("login") // 用途：login、resetPwd 等
	expiresAt  DateTime
	usedAt     DateTime?

	@@index([phone])
	@@index([purpose])
}

// =====================
// 商店 与 订单系统 模型
// =====================

// 商品类型：服务项目/实物商品/虚拟卡券
enum ProductType {
	SERVICE
	PHYSICAL
	VIRTUAL_CARD
}

// 商品规格类型：单规格/多规格
enum ProductSpecType {
	SINGLE
	MULTI
}

// 库存流水原因
enum InventoryLogReason {
	INBOUND
	OUTBOUND
	ADJUSTMENT
	ORDER_DEDUCT
	ORDER_ROLLBACK
	REFUND_RETURN
}

// 订单类型：SERVICE 服务订单，SP 商品订单（含实物与虚拟卡券），FK 付款订单
enum OrderType {
	SERVICE
	SP
	FK
}

// 订单状态
enum OrderStatus {
	CREATED
	PAID
	FULFILLED
	CLOSED
	CANCELLED
}

// 支付状态
enum PayStatus {
	UNPAID
	PAID
	REFUNDED
	CANCELLED
}

// 支付方式（仅手动确认的三种）
enum PayMethod {
	CASH
	SHOUQIANBA
	OFFLINE
}

// 卡券相关
enum CouponType {
	COUPON      // 优惠券（满减/直减等，后续扩展）
	WASH_CARD   // 洗车计次卡
}

// 卡券适用范围
enum CouponApplyScope {
	ALL
	SPECIFIED
}

// 有效期类型
enum CouponExpiryType {
	FIXED           // 固定时间段（配合 startAt/endAt）
	AFTER_RECEIVE   // 领取后生效（配合 validDays）
	PERMANENT       // 永久有效
}

model CouponGroup {
	id         Int       @id @default(autoincrement())
	createdAt  DateTime  @default(now())
	updatedAt  DateTime  @updatedAt
	name       String
	description String?
	enabled    Boolean   @default(true)
	weight     Int       @default(0)

	coupons    Coupon[]
}

model Coupon {
	id           Int         @id @default(autoincrement())
	createdAt    DateTime    @default(now())
	updatedAt    DateTime    @updatedAt
	name         String
	type         CouponType
	groupId      Int?
	group        CouponGroup? @relation(fields: [groupId], references: [id])
	// 基础适用与有效期
	expiryType   CouponExpiryType @default(PERMANENT)
	startAt      DateTime?
	endAt        DateTime?
	enabled      Boolean     @default(true)
	// 优惠券参数（可扩展JSON）
	ruleJson     Json?
	// 计次卡参数
	totalTimes   Int         @default(0)
	validDays    Int?        // 自领取起有效天数，空则不限制

	// 通用展示与备注
	imageUrl     String?
	description  String?
	adminRemark  String?

	// 优惠券专用
	faceValue        Decimal?
	minOrderAmount   Decimal?
	issueTotal       Int?
	applyScope       CouponApplyScope @default(ALL)

	// 指定商品适用（当 applyScope = SPECIFIED 生效）
	applicableProducts CouponApplicableProduct[]

	// 反向引用：被商品绑定
	products     Product[]
}

// 卡券与可用商品的多对多关联
model CouponApplicableProduct {
	id         Int     @id @default(autoincrement())
	couponId   Int
	productId  Int
	coupon     Coupon  @relation(fields: [couponId], references: [id])
	product    Product @relation(fields: [productId], references: [id])

	@@unique([couponId, productId])
	@@index([productId])
}

model ProductCategory {
	id         Int       @id @default(autoincrement())
	createdAt  DateTime  @default(now())
	updatedAt  DateTime  @updatedAt
	name       String
	imageUrl   String?
	enabled    Boolean   @default(true)
	weight     Int       @default(0)

	products   Product[]
}

model Product {
	id               Int             @id @default(autoincrement())
	createdAt        DateTime        @default(now())
	updatedAt        DateTime        @updatedAt
	deletedAt        DateTime?
	type             ProductType
	name             String
	barcode          String?         @unique
	categoryId       Int?
	category         ProductCategory? @relation(fields: [categoryId], references: [id])
	imageUrl         String?
	imagesJson       Json?
	// 规格项定义：如 [{ name:"颜色", values:["红","蓝"] }, { name:"尺码", values:["S","M"] }]
	specsDefinitionJson Json?
	sortWeight       Int             @default(0)
	enabled          Boolean         @default(true)
	description      String?
	// 扩展项
	pointsDeductible Boolean         @default(false)
	memberDiscount   Boolean         @default(false)
	specType         ProductSpecType @default(SINGLE)
	// 单规格商品字段（当 specType=SINGLE 生效）
	price            Decimal?        @default(0)
	listPrice        Decimal?        @default(0)
	stockQuantity    Int?            @default(0)
	// 销量与卖点
	initialSales     Int             @default(0)
	sellPoint        String?
	// 绑定卡券（虚拟卡券商品绑定到某个卡券）
	couponId         Int?
	coupon           Coupon?         @relation(fields: [couponId], references: [id])

	// 作为可用商品被卡券指定
	applicableInCoupons CouponApplicableProduct[]

	skus             ProductSku[]
	inventoryLogs    InventoryLog[]
}

model ProductSku {
	id            Int       @id @default(autoincrement())
	createdAt     DateTime  @default(now())
	updatedAt     DateTime  @updatedAt
	productId     Int
	product       Product   @relation(fields: [productId], references: [id])
	// 规格信息可存放在 name 与 specsJson
	name          String
	specsJson     Json?
	skuCode       String    @unique
	barcode       String?
	imageUrl      String?
	price         Decimal   @default(0)
	listPrice     Decimal   @default(0)
	stockQuantity Int       @default(0)
	enabled       Boolean   @default(true)

	inventoryLogs InventoryLog[]

	@@index([productId])
}

model InventoryLog {
	id             Int                @id @default(autoincrement())
	createdAt      DateTime           @default(now())
	productId      Int
	product        Product            @relation(fields: [productId], references: [id])
	skuId          Int?
	sku            ProductSku?        @relation(fields: [skuId], references: [id], onDelete: SetNull)
	change         Int                // +入库/-出库
	beforeStock    Int
	afterStock     Int
	reason         InventoryLogReason
	remark         String?

	operatorUserId Int?
	operatorUser   User?              @relation(fields: [operatorUserId], references: [id])

	@@index([productId])
	@@index([skuId])
}

model Order {
	id              Int         @id @default(autoincrement())
	createdAt       DateTime    @default(now())
	updatedAt       DateTime    @updatedAt
	no              String      @unique
	type            OrderType
	status          OrderStatus @default(CREATED)
	// 金额相关
	totalAmount     Decimal     @default(0)
	discountAmount  Decimal     @default(0)
	payAmount       Decimal     @default(0)
	shippingFee     Decimal     @default(0)
	// 支付相关
	payStatus       PayStatus   @default(UNPAID)
	payMethod       PayMethod?
	paidAt          DateTime?
	// 权益/积分/卡券
	usedPoints      Int         @default(0)
	pointsAmount    Decimal     @default(0)
	couponInfo      Json?
	// 会员信息
	memberId        Int
	member          Member      @relation(fields: [memberId], references: [id])
	// 服务订单追加：车辆
	vehicleId       Int?
	vehicle         Vehicle?    @relation(fields: [vehicleId], references: [id])
	// 备注
	remark          String?

	items           OrderItem[]

	@@index([type])
	@@index([status])
	@@index([memberId])
}

model OrderItem {
	id          Int       @id @default(autoincrement())
	createdAt   DateTime  @default(now())
	orderId     Int
	order       Order     @relation(fields: [orderId], references: [id])
	// 商品信息快照
	productId   Int?
	skuId       Int?
	name        String
	imageUrl    String?
	specsText   String?
	barcode     String?
	price       Decimal   @default(0)
	discount    Decimal   @default(0)
	quantity    Int       @default(1)

	@@index([orderId])
}

// 会员收货地址
model MemberAddress {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memberId   Int
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // 行政区层级：省/市/区/街道 名称
  province   String
  city       String
  district   String
  street     String

  // 详细地址与门牌号
  detail     String

  // 联系手机号
  phone      String

  // 可选标签：家/公司/学校/父母/朋友/自定义（≤4字）
  label      String?

  @@index([memberId])
}