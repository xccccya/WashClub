# Required for API startup
DATABASE_URL="mysql://wash_app:replace_me@127.0.0.1:3306/wash_club"
JWT_SECRET="replace_with_a_strong_random_value_at_least_32_characters"

# Runtime
PORT=3000
TZ=Asia/Shanghai
ADMIN_JWT_EXPIRES_IN=1d
MEMBER_JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Business fallback records; GUEST_MEMBER_ID must reference an existing Member row
GUEST_MEMBER_ID=0
NO_PLATE_NUMBER=川K00000

# Order and notification schedulers
ORDER_TIMEOUT_ENABLED=true
ORDER_TIMEOUT_SCAN_MS=60000
NOTIFY_DB_SCHEDULER_INTERVAL_MS=30000
NOTIFY_DB_SCHEDULER_STALE_LOCK_MS=600000

# Public HTTPS base used to build WeChat payment/refund callback URLs
PUBLIC_API_BASE="https://api.example.invalid"

# Redis: prefer REDIS_URL, or use the split fields below
REDIS_URL="redis://127.0.0.1:6379"
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Tencent Cloud SMS
TENCENTCLOUD_SECRET_ID="replace_me"
TENCENTCLOUD_SECRET_KEY="replace_me"
SMS_REGION=ap-nanjing
SMS_SDK_APP_ID="replace_me"
SMS_SIGN_NAME="replace_me"
SMS_TEMPLATE_ID="replace_me"

# WeChat mini program
WECHAT_MINIAPP_APPID="replace_me"
WECHAT_MINIAPP_SECRET="replace_me"

# WeChat Pay
WXPAY_MCH_ID="replace_me"
WXPAY_API_V3="replace_me"
WXPAY_API_V2="replace_me_if_v2_is_still_used"
WXPAY_MCH_PRIVATE_KEY="C:/secure/wxpay/apiclient_key.pem"
WXPAY_MCH_CERT_SERIAL="replace_me"
WXPAY_PLATFORM_CERT="C:/secure/wxpay/wechatpay_platform.pem"

# Third-party server-side APIs
# 高德 Web Service API：服务端 Key，仅用于 POI、天气、行政区和驾车路线；该产品没有 securityJsCode。
AMAP_WEBSERVICE_KEY="replace_with_server_webservice_key"
# 高德 Web 端 JSAPI v2.0：仅供前端 serviceHost 代理追加安全码；它不是 Web Service 凭据。
AMAP_JSAPI_SECURITY_JSCODE="replace_with_web_jsapi_security_code"
TANSHU_CAR_API_KEY="replace_me"
