VITE_API_BASE="http://127.0.0.1:3000"
VITE_NO_PLATE_NUMBER="川K00000"

# 高德 Web 端 JSAPI v2.0：用于浏览器地图渲染，不是 Web Service API Key。
VITE_AMAP_JSAPI_KEY="replace_with_web_jsapi_key"
# 生产环境必须配置 serviceHost，由 API 代理追加 AMAP_JSAPI_SECURITY_JSCODE。
VITE_AMAP_JSAPI_SERVICE_HOST="http://127.0.0.1:3000/_AMapService"
# JSAPI 安全码，仅本地开发可明文配置；生产构建必须留空。Web Service API 不使用该变量。
VITE_AMAP_JSAPI_SECURITY_JSCODE=""
