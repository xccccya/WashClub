VITE_API_BASE="http://127.0.0.1:3000"

# H5 地图渲染使用的 Web 端 JSAPI v2.0 凭据；微信小程序原生 map 不读取它们。
VITE_AMAP_JSAPI_KEY="replace_with_web_jsapi_key"
VITE_AMAP_JSAPI_SERVICE_HOST="http://127.0.0.1:3000/_AMapService"
# JSAPI 安全码，仅本地 H5 开发可明文配置；生产构建必须留空。
VITE_AMAP_JSAPI_SECURITY_JSCODE=""

# Longitude,latitude
VITE_STORE_LOCATION="0,0"
